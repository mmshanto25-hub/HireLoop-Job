# ---------------------------------------------------------------------------
# HireLoop environment configuration
# Copy to apps/api/.env for the API. Never commit real secrets.
# The API validates this file at startup and exits with a clear error if a
# required value is missing or malformed (see apps/api/src/config/env.ts).
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# Public URLs (no trailing slash)
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000

# Database. Local: mongodb://127.0.0.1:27017/hireloop
# Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/hireloop
MONGODB_URI=

# Authentication secrets (each at least 32 random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Google sign-in. All three are needed together, or leave all three empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Email. "console" prints messages to the API terminal (development only).
# Production requires "resend" with EMAIL_API_KEY set.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=HireLoop <no-reply@localhost>

# Phase 3+ (file storage)
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

# Phase 5+ (Stripe, test mode for development)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SEEKER_PRO_PRICE_ID=
STRIPE_SEEKER_PREMIUM_PRICE_ID=
STRIPE_RECRUITER_GROWTH_PRICE_ID=
STRIPE_RECRUITER_ENTERPRISE_PRICE_ID=

# Read only by `npm run bootstrap:admin`. Do not keep these in .env after use.
# ADMIN_EMAIL=
# ADMIN_FULL_NAME=
# ADMIN_PASSWORD=
